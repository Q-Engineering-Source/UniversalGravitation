.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea

# Local credentials and machine-specific overrides
.env
.env.*
!.env.example
local.properties
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Local development evidence and private collaboration state.
logs/
team-receipts/
.superpowers/
.pensieve/
.codex/
AGENTS.md
CLAUDE.md
CONTEXT.md
docs/progress/
docs/evidence/
tools/progress/

# Template workflows need external CHB/UIE inputs before public CI can run.
.github/workflows/
